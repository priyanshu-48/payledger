{
  "uid": "payledger",
  "title": "PayLedger",
  "tags": ["payledger"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "editable": true,
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Payments by status",
      "description": "Rows in each payment status, straight from the payments table (payment-service).",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (status) (payments_by_status)", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 2, "type": "timeseries", "title": "Outbox lag: age of the oldest unpublished event",
      "description": "0 when everything is on Kafka. Grows while Kafka or the poller is down.",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "max by (application) (outbox_oldest_unpublished_age_seconds)", "legendFormat": "{{application}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 3, "type": "timeseries", "title": "Consumer lag (messages behind)",
      "description": "Latest offset minus committed offset per consumer group, asked of the broker.",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "max by (group, topic) (kafka_consumer_group_lag)", "legendFormat": "{{group}} on {{topic}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 4, "type": "timeseries", "title": "Transfer latency (ledger-service)",
      "description": "Created transfers only; p50/p95/p99 from the ledger.transfer.duration histogram.",
      "gridPos": {"x": 0, "y": 7, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(ledger_transfer_duration_seconds_bucket{outcome=\"created\"}[1m])))", "legendFormat": "p50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(ledger_transfer_duration_seconds_bucket{outcome=\"created\"}[1m])))", "legendFormat": "p95"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(ledger_transfer_duration_seconds_bucket{outcome=\"created\"}[1m])))", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 5}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 5, "type": "timeseries", "title": "Transfers per second by outcome",
      "description": "created, replayed (same idempotency key) or the type of refusal.",
      "gridPos": {"x": 12, "y": 7, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (outcome) (rate(ledger_transfer_duration_seconds_count[1m]))", "legendFormat": "{{outcome}}"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 6, "type": "timeseries", "title": "HTTP requests per second",
      "gridPos": {"x": 0, "y": 14, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{application}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 7, "type": "timeseries", "title": "HTTP p95 latency by service",
      "gridPos": {"x": 8, "y": 14, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket[1m])))", "legendFormat": "{{application}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 5}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 8, "type": "timeseries", "title": "Rate-limited requests (429) per minute",
      "gridPos": {"x": 16, "y": 14, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (application) (increase(http_server_requests_seconds_count{status=\"429\"}[1m]))", "legendFormat": "{{application}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 9, "type": "bargauge", "title": "Reconciliation mismatches found (all runs since start)",
      "gridPos": {"x": 0, "y": 21, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (outcome) (recon_mismatches_total)", "legendFormat": "{{outcome}}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "color": {"mode": "fixed", "fixedColor": "orange"}}, "overrides": []},
      "options": {"orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 10, "type": "stat", "title": "Reconciliation runs",
      "gridPos": {"x": 8, "y": 21, "w": 4, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (status) (recon_runs_total)", "legendFormat": "{{status}}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 11, "type": "timeseries", "title": "Outbox backlog (unpublished rows)",
      "gridPos": {"x": 12, "y": 21, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "max by (application) (outbox_unpublished)", "legendFormat": "{{application}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 12, "type": "timeseries", "title": "JVM heap used",
      "gridPos": {"x": 18, "y": 21, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{application}}"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 5}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    }
  ]
}
