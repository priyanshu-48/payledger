# The only public entry point (ADR 0023). Caddy gets and renews the HTTPS certificate by itself; on a name such as
# 203-0-113-7.sslip.io (resolves to 203.0.113.7, no DNS account needed) Let's Encrypt can issue it, and for
# PUBLIC_HOST=localhost Caddy uses its own local certificate authority, which is how this file is tested on a laptop.
{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# read-only dashboards (anonymous Viewer; editing needs the Grafana admin password, which stays on the VM)
	handle /grafana/* {
		reverse_proxy grafana:3000
	}

	# the console; nginx inside it forwards /api/* to the services and answers 404 for actuator and the mock bank
	handle {
		reverse_proxy admin-ui:80
	}
}
