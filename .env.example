# Copy to .env (gitignored) and fill in every value below. Docker Compose refuses to start while one is empty.
# Generate each one with:  openssl rand -hex 16   (or any password manager)
POSTGRES_PASSWORD=
LEDGER_DB_PASSWORD=
PAYMENTS_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=
GRAFANA_PASSWORD=
AUTH_DB_PASSWORD=
# password of the first ADMIN user ("admin"), at least 10 characters
AUTH_ADMIN_PASSWORD=
# shared secret the payment service sends to its stand-in bank
BANK_API_KEY=
# password of the "admin" user of the local Jenkins (jenkins/docker-compose.yml)
JENKINS_ADMIN_PASSWORD=
# optional: PKCS8 PEM private key for token signing; empty = generate at startup (tokens die on restart)
AUTH_JWT_PRIVATE_KEY=
