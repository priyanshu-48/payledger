# copy to .env (gitignored) and change the passwords
POSTGRES_PASSWORD=change-me
LEDGER_DB_PASSWORD=change-me
PAYMENTS_DB_PASSWORD=change-me
NOTIFICATIONS_DB_PASSWORD=change-me
GRAFANA_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me
# password of the first ADMIN user ("admin"), at least 10 characters
AUTH_ADMIN_PASSWORD=change-me-please
# shared secret the payment service sends to its stand-in bank
BANK_API_KEY=change-me
# optional: PKCS8 PEM private key for token signing; empty = generate at startup (tokens die on restart)
AUTH_JWT_PRIVATE_KEY=
